# Local PostgreSQL container settings
POSTGRES_DB=repopilot
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# FastAPI database connection
DATABASE_URL=postgresql+psycopg://repopilot:change-me@127.0.0.1:5432/repopilot?connect_timeout=3

# Browser origin allowed by the local FastAPI server
FRONTEND_ORIGIN=http://localhost:5173

# Only repositories inside this directory can be ingested. Relative API paths resolve here.
REPOSITORY_ALLOWED_ROOT=.

# Backend URL used by the Vite frontend
VITE_API_BASE_URL=http://localhost:8000
