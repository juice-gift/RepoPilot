# Local PostgreSQL container settings
POSTGRES_DB=repopilot
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# FastAPI database connection
DATABASE_URL=postgresql+psycopg://repopilot:change-me@127.0.0.1:5432/repopilot?connect_timeout=3

# Browser origin allowed by the local FastAPI server
FRONTEND_ORIGIN=http://localhost:5173

# Only repositories inside this directory can be ingested. Relative API paths resolve here.
REPOSITORY_ALLOWED_ROOT=.

# Use deterministic for zero-cost local evaluation; qwen and openai are external providers.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=512
RETRIEVAL_STRATEGY=hybrid
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-0qeb5e7r8oa2y0s1.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Use deterministic locally; qwen and openai use their compatible Responses APIs.
GENERATION_PROVIDER=deterministic
GENERATION_MODEL=gpt-5.6-luna
QWEN_GENERATION_MODEL=qwen3.7-flash
GENERATION_MAX_OUTPUT_TOKENS=1200
CONTEXT_CHARACTER_LIMIT=24000
CONTEXT_MAX_EVIDENCE=8

# Backend URL used by the Vite frontend
VITE_API_BASE_URL=http://localhost:8000
