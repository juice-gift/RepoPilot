    {
      "id": "trusted-more-itertools",
      "repository": "more-itertools/more-itertools",
      "commit_sha": "64be96ceb2a6e836f76f069f4a96d2394d59fd0c",
      "issue": "GitHub issue more-itertools/more-itertools#1336: replace produces padding or replacement output for an empty iterable with window_size greater than one. Empty input must yield nothing for either predicate outcome; preserve genuine None values and normal replacement behavior.",
      "image_id": "sha256:8aa71903f763491db90e2fa2ec4f60944b57aef16dd874aaf8817d43e880d958",
      "import_root": ".",
      "expected_sources": {
        "more_itertools/__init__.py": "19cb2d318e8d45eb7d56136a55f1452c9469d21597571c31d752aa8232a2c07b",
        "more_itertools/more.py": "f2ad17370b06905e981b524213395f0dee3d072e9c3ddab3d65e671f324e5ace",
        "more_itertools/recipes.py": "6aff1f84b0a70b96c102e3b92a70539255f1489765fc54140b1c1478f95b4828"
      },
