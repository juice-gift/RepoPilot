        "more_itertools/more.py"
      ],
      "validation": {
        "test_replace_empty.py": "import pytest\nimport more_itertools\nfrom more_itertools import replace\n\nassert more_itertools.__file__.startswith(\"/workspace/more_itertools/\")\n\n\n@pytest.mark.parametrize(\"window_size\", [2, 3, 4])\n@pytest.mark.parametrize(\"match\", [False, True])\ndef test_empty_input_never_yields_padding(window_size, match):\n    assert list(replace([], lambda *args: match, [9], window_size=window_size)) == []\n\n\ndef test_actual_none_is_preserved():\n    assert list(replace([None], lambda *args: False, [9], window_size=2)) == [None]\n\n\ndef test_normal_replacement_is_preserved():\n    assert list(replace([1, 2, 3], lambda *args: args == (1, 2), [9], window_size=2)) == [9, 3]\n\n\ndef test_default_empty_input():\n    assert list(replace([], lambda *args: True, [9])) == []\n"
      },
      "expected_tests": 9,
      "baseline_failures": 6,
      "source_evidence_limit": 500000,
      "issue_number": 1336,
      "original_issue_body": "With `window_size > 1`, `replace()` yields an item for an empty iterable, and *pred* gets called with a `None` that isn't in the input:\n\n```python\n>>> from more_itertools import replace\n>>> list(replace([], lambda *args: False, [9], window_size=2))\n[None]\n>>> list(replace([], lambda *args: True, [9], window_size=2))\n[9]\n>>> list(replace([], lambda *args: False, [9]))  # window_size=1 is fine\n[]\n```\n\n`replace()` pads the iterable with `window_size - 1` `_marker`s and then strips them from each window. For an empty iterable that padding is still one item shorter than a window, so `windowed()` fills the rest with its default `fillvalue=None`, which the marker stripping doesn't remove. `locate()` avoids this by passing `fillvalue=_marker` to `windowed()`.\n\nSame result on 11.1.0 and on master.",
      "baseline_tree_sha": "f7409b66b75d5649b9fc6414114f8035362f9fcf",
